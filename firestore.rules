rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Princípio: o visitante anônimo NÃO lê nem escreve nada direto no
    // Firestore. O link público do cliente usa as funções serverless
    // (api/negocio, api/criar-agendamento, api/agendamento-cliente), que
    // usam o Admin SDK (ignora estas regras), validam tudo no servidor e
    // devolvem só o que o visitante pode ver. Estas regras existem para
    // quem trabalha no negócio (painel /admin) e para a 77 IS (/painel77).
    // Testadas contra o emulador: npm run test:regras (tests/regras/).
    // ------------------------------------------------------------------

    function autenticado() { return request.auth != null; }

    function isSuperAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/admins77/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins77/$(request.auth.uid)).data.role == 'super_admin';
    }

    // ---- Papéis dentro de um negócio ------------------------------------
    // usuarios/{uid} = { barbeariaId, role, profissionalId?, permissoes?: { verTodos, gerirNegocio } }
    //  - verTodos:     enxerga agenda, clientes e faturamento de TODOS os profissionais
    //  - gerirNegocio: edita dados do negócio e o catálogo de serviços
    //  - sem verTodos, o usuário só enxerga o que é do PRÓPRIO profissional (profissionalId)
    // Conta antiga (role 'owner' e sem "permissoes") continua com acesso total, como sempre foi.
    // Só o servidor grava usuarios/{uid} (api/cadastrar-negocio, api/criar-usuario, api/equipe).
    function usuarioDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function membro(slug) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && usuarioDoc().barbeariaId == slug;
    }

    function temPermissao(nome) {
      return !('permissoes' in usuarioDoc())
        ? usuarioDoc().get('role', 'owner') == 'owner'
        : usuarioDoc().permissoes.get(nome, false) == true;
    }

    function verTodos(slug)     { return membro(slug) && temPermissao('verTodos'); }
    function gerirNegocio(slug) { return membro(slug) && temPermissao('gerirNegocio'); }
    // administrador pleno: vê tudo E gere o negócio (o dono de sempre)
    function admin(slug)        { return verTodos(slug) && gerirNegocio(slug); }

    function meuProfissional(slug) {
      return membro(slug) ? usuarioDoc().get('profissionalId', '') : '';
    }
    function souOProfissional(slug, id) {
      return membro(slug) && meuProfissional(slug) != '' && meuProfissional(slug) == id;
    }

    function dataChaveOk(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function horarioOk(v)   { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function statusAgOk(v)  { return v in ['confirmado', 'concluido', 'cancelado', 'aguardando_sinal', 'sinal_informado']; }

    // Forma mínima de um agendamento criado pelo painel (agendamento manual).
    // O agendamento do cliente final é criado pelo servidor.
    function agendamentoNovoOk(d) {
      return d.clienteWhatsapp is string && d.clienteWhatsapp.matches('^[0-9]{10,15}$')
        && d.clienteNome is string && d.clienteNome.size() >= 1 && d.clienteNome.size() <= 80
        && d.profissionalId is string && d.profissionalId.size() > 0 && d.profissionalId.size() <= 64
        && dataChaveOk(d.dataChave)
        && horarioOk(d.horario)
        && d.duracaoMin is number && d.duracaoMin > 0 && d.duracaoMin <= 720
        && d.valorTotal is number && d.valorTotal >= 0 && d.valorTotal <= 100000
        && statusAgOk(d.status)
        && d.servicos is list && d.servicos.size() > 0 && d.servicos.size() <= 20;
    }

    // ---- 77 IS ----------------------------------------------------------

    match /admins77/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Vínculo usuário -> negócio. Era o furo mais grave: qualquer usuário logado
    // podia gravar o próprio usuarios/{uid} apontando pra QUALQUER negócio e
    // virar "dono" dele. Agora só o servidor cria e altera (api/cadastrar-negocio.js,
    // api/criar-usuario.js e api/equipe.js).
    match /usuarios/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Fila de aprovação: criada pelo servidor (cadastrar-negocio); a 77 IS lê e aprova/recusa.
    match /cadastrosAguardando/{slug} {
      allow read, write: if isSuperAdmin();
    }

    match /logs77/{id} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Negócios -------------------------------------------------------

    match /barbearias/{slug} {
      // Sem leitura pública (o visitante usa /api/negocio). O doc guardava
      // coisas internas (criadoPor, plano, trial) que não devem vazar.
      allow get: if membro(slug) || isSuperAdmin();
      allow list: if isSuperAdmin();

      // Criado só pelo servidor (cadastrar-negocio) com status 'aguardando_aprovacao'.
      allow create, delete: if false;

      // Quem gere o negócio só altera dados cadastrais. status / plano / trialFim / aprovadaEm
      // etc. ficam só com a 77 IS — antes o dono podia se auto-conceder trial infinito.
      allow update: if isSuperAdmin()
        || (gerirNegocio(slug)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nome', 'endereco', 'telefone', 'horarioFuncionamento'])
            && request.resource.data.nome is string
            && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 80
            && request.resource.data.endereco is string && request.resource.data.endereco.size() <= 200
            && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20
            && request.resource.data.horarioFuncionamento is map);

      // Catálogo de serviços: todos do negócio leem; só quem gere o negócio altera.
      match /servicos/{id} {
        allow read: if membro(slug) || isSuperAdmin();
        allow write: if gerirNegocio(slug) || isSuperAdmin();
      }

      // Profissionais: comissão e horário de cada um são privados. Quem não vê tudo lê só o PRÓPRIO cadastro e
      // altera só o próprio horário (horarioTrabalho/bloqueios) e os dados de apresentação.
      match /profissionais/{id} {
        allow get: if verTodos(slug) || isSuperAdmin() || souOProfissional(slug, id);
        allow list: if verTodos(slug) || isSuperAdmin();
        allow create, delete: if admin(slug) || isSuperAdmin();
        allow update: if admin(slug) || isSuperAdmin()
          || (souOProfissional(slug, id)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['horarioTrabalho', 'bloqueios', 'nome', 'especialidade']));
      }

      // Tokens de notificação push (por enquanto só quem vê tudo; por profissional vem depois).
      match /dispositivos/{deviceId} {
        allow read, write: if verTodos(slug) || isSuperAdmin();
      }

      // Agendamentos: quem vê tudo acessa todos; os demais só os do PRÓPRIO profissional (a consulta precisa
      // filtrar por profissionalId, senão o Firestore recusa). Ninguém passa um agendamento para outro profissional.
      match /agendamentos/{id} {
        allow get, list: if verTodos(slug) || isSuperAdmin() || souOProfissional(slug, resource.data.profissionalId);
        allow create: if (verTodos(slug) || isSuperAdmin() || souOProfissional(slug, request.resource.data.profissionalId))
          && agendamentoNovoOk(request.resource.data);
        // Em update o documento resultante precisa continuar com data/horário/status válidos
        allow update: if (verTodos(slug) || isSuperAdmin()
              || (souOProfissional(slug, resource.data.profissionalId)
                  && request.resource.data.profissionalId == resource.data.profissionalId))
          && dataChaveOk(request.resource.data.dataChave)
          && horarioOk(request.resource.data.horario)
          && statusAgOk(request.resource.data.status);
        allow delete: if verTodos(slug) || isSuperAdmin() || souOProfissional(slug, resource.data.profissionalId);
      }

      // Nome + WhatsApp dos clientes: só quem vê tudo (antes era leitura/escrita pública).
      // Quem só vê o próprio profissional monta a lista de clientes a partir dos PRÓPRIOS agendamentos.
      match /clientes/{whatsapp} {
        allow read, write: if verTodos(slug) || isSuperAdmin();
      }
    }
  }
}
